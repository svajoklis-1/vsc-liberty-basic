{
    "comments": {
        "lineComment": "'"
    },
    "brackets": [
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")", "notIn": ["string", "comment"] },
        { "open": "[", "close": "]", "notIn": ["string", "comment"] },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["\"", "\""]
    ],
    // Identifiers may contain dots and end in $; handles start with #
    "wordPattern": "(-?\\d*\\.\\d+(?:[eE][+-]?\\d+)?)|(#?[A-Za-z_][A-Za-z0-9._]*\\$?)|(-?\\d+(?:[eE][+-]?\\d+)?)",
    "indentationRules": {
        // SUB, FUNCTION, block IF (THEN at end of line), ELSE, FOR, WHILE, DO, SELECT CASE, CASE
        // (?![\w.$]) is a word boundary that also treats . and $ as part of names
        "increaseIndentPattern": {
            "pattern": "^\\s*((sub|function)\\s+[a-z]|if(?![\\w.$]).*(?<![\\w.$#])then\\s*('.*)?$|else\\s*('.*)?$|(for|while|do|case)(?![\\w.$])|select\\s+case(?![\\w.$]))",
            "flags": "i"
        },
        // END SUB/FUNCTION/IF/SELECT, NEXT, WEND, LOOP, ELSE, CASE
        "decreaseIndentPattern": {
            "pattern": "^\\s*(end\\s+(sub|function|if|select)|next|wend|loop|else|case)(?![\\w.$])",
            "flags": "i"
        }
    }
}
