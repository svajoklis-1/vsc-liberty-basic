{
    "name": "liberty-basic",
    "displayName": "Liberty BASIC",
    "description": "Support for Liberty BASIC",
    "version": "1.1.0",
    "engines": {
        "vscode": "^1.100.0"
    },
    "icon": "images/liberty.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/svajoklis-1/vsc-liberty-basic.git"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "libertybasic",
                "aliases": [
                    "Liberty BASIC",
                    "libertybasic"
                ],
                "extensions": [
                    ".bas"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "libertybasic",
                "scopeName": "source.libertybasic",
                "path": "./syntaxes/libertybasic.tmLanguage.json"
            }
        ]
    },
    "publisher": "vytenis-narusis",
    "main": "./out/main.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint src",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && npm run test:unit && npm run test:grammar",
        "test:unit": "node --test \"out/test/**/*.test.js\"",
        "test:grammar": "vscode-tmgrammar-snap \"test/grammar/*.bas\"",
        "package": "vsce package"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^20.19.0",
        "@types/vscode": "~1.100.0",
        "@vscode/vsce": "^4.0.0",
        "eslint": "^10.12.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.1",
        "vscode-tmgrammar-test": "^0.1.3"
    }
}
