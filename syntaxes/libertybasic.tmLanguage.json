{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Liberty BASIC",
	"scopeName": "source.libertybasic",
	"comment": "Liberty BASIC 4.5.1. Identifiers may contain letters, digits and dots and may end in $, so word boundaries are written as (?<![A-Za-z0-9.$#_]) and (?![A-Za-z0-9.$_]) instead of \\b.",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#strings" },
		{ "include": "#line-numbers" },
		{ "include": "#labels" },
		{ "include": "#handles" },
		{ "include": "#definitions" },
		{ "include": "#open-modes" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#builtin-functions" },
		{ "include": "#statements" },
		{ "include": "#special-variables" },
		{ "include": "#windows-constants" },
		{ "include": "#numbers" },
		{ "include": "#operators" },
		{ "include": "#punctuation" },
		{ "include": "#variables" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.apostrophe.libertybasic",
					"match": "(').*$",
					"captures": {
						"1": { "name": "punctuation.definition.comment.libertybasic" }
					}
				},
				{
					"name": "comment.line.rem.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(rem)(?![A-Za-z0-9.$_]).*$",
					"captures": {
						"1": { "name": "punctuation.definition.comment.libertybasic" }
					}
				}
			]
		},
		"strings": {
			"comment": "No escapes and no embedded quotes (use chr$(34)); an unterminated string ends at the end of the line.",
			"name": "string.quoted.double.libertybasic",
			"begin": "\"",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.string.begin.libertybasic" }
			},
			"end": "\"|$",
			"endCaptures": {
				"0": { "name": "punctuation.definition.string.end.libertybasic" }
			}
		},
		"line-numbers": {
			"comment": "Numeric branch labels at the start of a line, e.g. 10 REM",
			"match": "^[ \\t]*(\\d+)(?=[ \\t])",
			"captures": {
				"1": { "name": "entity.name.label.line-number.libertybasic" }
			}
		},
		"labels": {
			"name": "entity.name.label.libertybasic",
			"match": "\\[[A-Za-z_.][A-Za-z0-9_.]*\\]"
		},
		"handles": {
			"comment": "#main, #main.button1, #2, and handle variables like #var$",
			"name": "variable.other.handle.libertybasic",
			"match": "#[A-Za-z0-9][A-Za-z0-9.]*\\$?"
		},
		"definitions": {
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9.$#_])(?<![Ee][Nn][Dd][ \\t]|[Ee][Xx][Ii][Tt][ \\t])((?i:function|sub))[ \\t]+([A-Za-z][A-Za-z0-9.]*\\$?)",
					"captures": {
						"1": { "name": "storage.type.function.libertybasic" },
						"2": { "name": "entity.name.function.libertybasic" }
					}
				},
				{
					"match": "(?i)(?<![A-Za-z0-9.$#_])(call)[ \\t]+([A-Za-z][A-Za-z0-9.]*\\$?)",
					"captures": {
						"1": { "name": "keyword.control.libertybasic" },
						"2": { "name": "entity.name.function.libertybasic" }
					}
				}
			]
		},
		"open-modes": {
			"comment": "OPEN device FOR purpose AS #handle: file modes, DLL, and window types with style suffixes",
			"match": "(?i)(?<![A-Za-z0-9.$#_])(for)[ \\t]+(input|output|append|random|binary|dll|(?:window|graphics|dialog|text)(?:_(?:fs|nf|nsb|ins|popup|modal))*)(?![A-Za-z0-9.$_])",
			"captures": {
				"1": { "name": "keyword.control.libertybasic" },
				"2": { "name": "keyword.other.open-mode.libertybasic" }
			}
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(on[ \\t]+error|if|then|else|end|exit|for|to|step|next|while|wend|do|loop|until|select|case|goto|gosub|return|call|resume|stop|wait)(?![A-Za-z0-9.$_])"
				},
				{
					"name": "storage.type.function.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(function|sub)(?![A-Za-z0-9.$_])"
				},
				{
					"name": "storage.modifier.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(global|byref)(?![A-Za-z0-9.$_])"
				},
				{
					"name": "storage.type.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(dim|redim|struct)(?![A-Za-z0-9.$_])"
				},
				{
					"name": "keyword.other.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(as|let)(?![A-Za-z0-9.$_])"
				}
			]
		},
		"types": {
			"comment": "Types for STRUCT fields and CALLDLL parameters",
			"name": "storage.type.primitive.libertybasic",
			"match": "(?i)(?<![A-Za-z0-9.$#_])(double|ulong|long|ushort|short|word|dword|ptr|void|none|boolean)(?![A-Za-z0-9.$_])"
		},
		"builtin-functions": {
			"comment": "Function names include the opening parenthesis in Liberty BASIC",
			"name": "support.function.builtin.libertybasic",
			"match": "(?i)(?<![A-Za-z0-9.$#_])(abs|acs|after\\$|afterlast\\$|asc|asn|atn|chr\\$|cos|date\\$|dechex\\$|eof|eval\\$?|exp|hbmp|hexdec|httpget\\$|hwnd|idecode\\$|idefilename\\$|inp|input\\$|inputto\\$|instr|int|left\\$|len|lof|log|lower\\$|max|midipos|mid\\$|min|mkdir|remchar\\$|replstr\\$|right\\$|rmdir|rnd|sin|space\\$|sqr|str\\$|tab|tan|time\\$|trim\\$|txcount|upper\\$|upto\\$|using|val|winstring|word\\$)(?=[ \\t]*\\()"
		},
		"statements": {
			"patterns": [
				{
					"name": "keyword.other.statement.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(line[ \\t]+input|beep|bmpsave|callback|calldll|callfn|close|cls|confirm|cursor|data|dump|field|files|gettrim|get|inputcsv|input|kill|loadbmp|locate|lprint|mainwin|maphandle|name|nomainwin|notice|oncomerror|open|out|playmidi|playwave|print|prompt|put|randomize|readjoystick|read|refresh|resizehandler|restore|run|scan|seek|sort|stopmidi|stylebits|timer|titlebar|trace|unloadbmp)(?![A-Za-z0-9.$_])"
				},
				{
					"name": "keyword.other.gui.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(bmpbutton|button|checkbox|combobox|graphicbox|groupbox|listbox|menu|popupmenu|radiobutton|statictext|textbox|texteditor|colordialog|filedialog|fontdialog|printerdialog)(?![A-Za-z0-9.$_])"
				}
			]
		},
		"special-variables": {
			"comment": "Built-in variables; variable names are case sensitive",
			"name": "support.variable.libertybasic",
			"match": "(?<![A-Za-z0-9.$#_])(BackgroundColor\\$|ComboboxColor\\$|CommandLine\\$|DefaultDir\\$|DisplayHeight|DisplayWidth|Drives\\$|Err\\$?|ForegroundColor\\$|Inkey\\$|Joy[12](?:x|y|z|button[12])|ListboxColor\\$|MouseX|MouseY|Platform\\$|PrintCollate|PrintCopies|PrinterFont\\$|PrinterName\\$|StartupDir\\$|TextboxColor\\$|TexteditorColor\\$|UpperLeftX|UpperLeftY|Version\\$|WindowHeight|WindowWidth)(?![A-Za-z0-9.$_])"
		},
		"windows-constants": {
			"comment": "Windows API constants such as _WS_VISIBLE",
			"name": "support.constant.windows.libertybasic",
			"match": "(?<![A-Za-z0-9.$#_])_[A-Za-z][A-Za-z0-9_]*"
		},
		"numbers": {
			"name": "constant.numeric.libertybasic",
			"match": "(?<![A-Za-z0-9.$#_])(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?(?![A-Za-z0-9.$_])"
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.logical.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])(and|or|xor|not)(?![A-Za-z0-9.$_])"
				},
				{
					"name": "keyword.operator.arithmetic.libertybasic",
					"match": "(?i)(?<![A-Za-z0-9.$#_])mod(?![A-Za-z0-9.$_])"
				},
				{
					"name": "keyword.operator.comparison.libertybasic",
					"match": "<>|<=|>=|=|<|>"
				},
				{
					"name": "keyword.operator.arithmetic.libertybasic",
					"match": "[-+*/^]"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.continuation.line.libertybasic",
					"match": "_(?=[ \\t]*$)"
				},
				{
					"name": "punctuation.separator.statement.libertybasic",
					"match": ":"
				},
				{
					"name": "punctuation.separator.comma.libertybasic",
					"match": ","
				},
				{
					"name": "punctuation.separator.semicolon.libertybasic",
					"match": ";"
				},
				{
					"name": "punctuation.parenthesis.open.libertybasic",
					"match": "\\("
				},
				{
					"name": "punctuation.parenthesis.close.libertybasic",
					"match": "\\)"
				}
			]
		},
		"variables": {
			"name": "variable.other.libertybasic",
			"match": "(?<![A-Za-z0-9.$#_])[A-Za-z][A-Za-z0-9.]*\\$?"
		}
	}
}
